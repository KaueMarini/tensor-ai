# Copie para .env.local e preencha (Supabase → Project Settings → API).
# Apenas a chave anon/publishable. NUNCA coloque a service_role no front.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Opcional: URL da org no DevOps, para o #id abrir o item no Azure DevOps
VITE_AZDO_ORG_URL=https://dev.azure.com/<org>
